{
  "name": "display",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint . --fix",
    "format": "eslint . --fix",
    "format:check": "eslint .",
    "typecheck": "nuxt typecheck",
    "deploy": "powershell -ExecutionPolicy Bypass -File ./deploy.ps1",
    "deploy:no-cache": "powershell -ExecutionPolicy Bypass -File ./deploy.ps1 -NoCache",
    "deploy:no-push": "powershell -ExecutionPolicy Bypass -File ./deploy.ps1 -NoPush",
    "audit": "npm audit & docker scout cves purduehkn/display:latest",
    "docker": "docker build -t purduehkn/display:latest . && docker run --rm -it -p 3000:3000 purduehkn/display:latest",
    "restart": "powershell -ExecutionPolicy Bypass -File ./deploy.ps1 -RestartOnly",
    "k8s:restart": "powershell -ExecutionPolicy Bypass -File ./deploy.ps1 -RestartOnly"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.137",
    "@iconify-json/simple-icons": "^1.2.97",
    "adm-zip": "^0.6.1",
    "gtfs-realtime-bindings": "^1.1.1",
    "papaparse": "^5.5.3",
    "swiper": "^12.2.0",
    "vue": "^3.5.40"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/image": "^2.2.0",
    "@nuxt/ui": "^4.12.0",
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^24.0.13",
    "@types/papaparse": "^5.3.16",
    "eslint": "^10.13.0",
    "nuxt": "4.6.2",
    "nuxt-swiper": "^2.0.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vue-tsc": "^3.3.13"
  },
  "engines": {
    "node": ">=26.12.1"
  },
  "packageManager": "npm@12.2.1",
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.0"
    },
    "rolldown": "1.2.15"
  }
}
